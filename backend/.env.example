DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=gjej_pro_dev
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
# Use 5433 for PostGIS-enabled pg16 alongside an existing pg14 on 5432.
# If you start docker-compose, also use 5433 (the postgis container exposes that port).
DB_PORT=5433

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002

FRONTEND_URL=http://localhost:3002

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Gjej Pro <noreply@gjejpro.al>
